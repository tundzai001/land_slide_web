<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.web>
    <!-- Keep ASP.NET request validation aligned with IIS requestFiltering. -->
    <httpRuntime maxRequestLength="4194303" executionTimeout="3600" />
  </system.web>
  <system.webServer>
    <!-- IIS HTTPS pre-read buffer (default 49,152 bytes); request body limit is below. -->
    <serverRuntime uploadReadAheadSize="16777216" />
    <security>
      <requestFiltering>
        <!-- IIS requestFiltering uses a 32-bit byte limit; set its maximum. -->
        <requestLimits maxAllowedContentLength="4294967295" />
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
