# =========================================================
# DATABASE CONFIGURATION
# =========================================================
# PostgreSQL asynchronous connection URLs (SQLAlchemy + asyncpg)
AUTH_DB_URL=postgresql+asyncpg://postgres:password@localhost:5432/landslide_auth
CONFIG_DB_URL=postgresql+asyncpg://postgres:password@localhost:5432/landslide_config
DATA_DB_URL=postgresql+asyncpg://postgres:password@localhost:5432/landslide_data

# Database connection pool tuning
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=30
DB_COMMAND_TIMEOUT_SECONDS=30

# =========================================================
# SECURITY & AUTHENTICATION
# =========================================================
# Random secret key of at least 32 bytes (generate with: python -c "import secrets; print(secrets.token_urlsafe(48))")
SECRET_KEY=generate_a_random_secret_key_at_least_32_bytes_long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
ENVIRONMENT=production

# Signing key for operations and backup integrity (defaults to SECRET_KEY if unset)
BACKUP_SIGNING_KEY=generate_a_random_signing_key_at_least_32_bytes_long
BACKUP_DIR=backups

# First-time database bootstrap (create admin user on clean database, then disable)
RUN_SCHEMA_BOOTSTRAP=false
BOOTSTRAP_ADMIN_PASSWORD=

# Public site settings & CORS
PUBLIC_SITE_URL=https://monitoring.example.com
CORS_ORIGINS=https://monitoring.example.com,http://127.0.0.1:8001,http://localhost:8001
PUBLIC_MONITORING_ENABLED=false
RESCUE_REQUEST_ENABLED=false

# Server binding
SERVER_HOST=127.0.0.1
SERVER_PORT=8001

# =========================================================
# MQTT BROKER CONFIGURATION
# =========================================================
MQTT_BROKER=broker.example.com
MQTT_PORT=1883
MQTT_USER=mqtt_user
MQTT_PASSWORD=your_mqtt_password_here
TOPIC_RELOAD_INTERVAL=60

# =========================================================
# NTRIP / AICASTER CONFIGURATION
# =========================================================
# Shared AICaster endpoints for SOURCE upload, control lookup and SET commands.
# Ordered primary -> failover.
NTRIP_HOSTS=caster1.example.com,caster2.example.com
NTRIP_PORT=2101
NTRIP_PASSWORD=your_caster_password

# =========================================================
# WEB CORS DASHBOARD INTEGRATION
# =========================================================
# Integration credentials for external CORS station management API
WEB_CORS_API_BASE_URL=https://base.example.com
CORS_BASE_STATIONS_URL=https://base.example.com/api/integrations/stations
CORS_BASE_STATIONS_TOKEN=your_cors_api_token
CORS_BASE_STATIONS_CACHE_TTL_SECONDS=20
CORS_BASE_STATIONS_STALE_TTL_SECONDS=300
CORS_BASE_STATIONS_RETRY_SECONDS=15
GNSS_CORS_FAILOVER_POLL_SECONDS=5

# Optional basic auth fallback for Web CORS
WEB_CORS_API_TOKEN=your_cors_api_token
WEB_CORS_API_USERNAME=
WEB_CORS_API_PASSWORD=

# =========================================================
# SENSOR INGESTION & DATA RETENTION (Seconds)
# =========================================================
SAVE_INTERVAL_DEFAULT=60
SAVE_INTERVAL_GNSS=86400
SAVE_INTERVAL_RAIN=3600
SAVE_INTERVAL_WATER=3600
SAVE_INTERVAL_IMU=2592000

GNSS_ROLLUP_INTERVAL_SECONDS=300
GNSS_PURGE_RAW_AFTER_DAILY_ROLLUP=false

# Time synchronization
NTP_SERVER=pool.ntp.org

# =========================================================
# MAPBOX CONFIGURATION
# =========================================================
MAPBOX_PUBLIC_TOKEN=
MAPBOX_ACCESS_TOKEN=
